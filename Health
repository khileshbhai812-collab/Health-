<script type="module">
import { createElement as h, useState, useEffect } from "https://esm.sh/react@18?external=react";
import { createRoot } from "https://esm.sh/react-dom@18/client?external=react";
const COLORS={forest:"#16342A",meadow:"#3C8558",paper:"#F7F9F4",line:"#E1E8DD",ink:"#1B2420",soft:"#5C6A5F"};
const todayStr=()=>new Date().toISOString().slice(0,10);
const daysAgo=(n)=>{const d=new Date();d.setDate(d.getDate()-n);return d.toISOString().slice(0,10);};
function App(){
  const [tab,setTab]=useState("home");
  const [habits,setHabits]=useState(()=>{
    const s=localStorage.getItem("habit-garden-v1-habits");
    if(s) return JSON.parse(s);
    return [
      {id:"1",name:"Morning water",icon:"💧",color:"#3C8558",completions:{[todayStr()]:true,[daysAgo(1)]:true,[daysAgo(2)]:true}},
      {id:"2",name:"10 min read",icon:"📚",color:"#2E6E9E",completions:{[todayStr()]:true,[daysAgo(1)]:true}},
      {id:"3",name:"Evening walk",icon:"🌿",color:"#D89B3C",completions:{[daysAgo(1)]:true}},
    ];
  });
  useEffect(()=>localStorage.setItem("habit-garden-v1-habits",JSON.stringify(habits)),[habits]);
  const toggle=(id)=>{
    setHabits(prev=>prev.map(h=>{
      if(h.id!==id) return h;
      const c={...h.completions}; const k=todayStr();
      if(c[k]) delete c[k]; else c[k]=true;
      return {...h,completions:c};
    }));
  };
  const pct=habits.length? habits.filter(h=>h.completions[todayStr()]).length/habits.length : 0;
  const streak=Math.max(0,...habits.map(h=>{
    let s=0, cur=new Date();
    if(!h.completions[todayStr()]) cur.setDate(cur.getDate()-1);
    while(h.completions[cur.toISOString().slice(0,10)]){s++;cur.setDate(cur.getDate()-1);}
    return s;
  }),0);
  const nav=[{id:"home",label:"Home",icon:"🏠"},{id:"habits",label:"Habits",icon:"✅"},{id:"progress",label:"Progress",icon:"📈"}];
  useEffect(()=>{
    const el=document.getElementById("main-nav"); el.innerHTML="";
    nav.forEach(n=>{
      const b=document.createElement("button");
      b.textContent=n.icon+" "+n.label;
      b.style.cssText=`text-align:left;padding:10px 12px;border-radius:10px;border:1px solid ${tab===n.id?COLORS.meadow+"33":"transparent"};background:${tab===n.id?"#DCEBDF":"transparent"};font-size:14px;cursor:pointer;font-weight:${tab===n.id?600:400}`;
      b.onclick=()=>setTab(n.id); el.appendChild(b);
    });
    document.getElementById("right-rail").style.display=window.innerWidth>1280?"flex":"none";
  },[tab]);
  return h("div",null,
    tab==="home" && h("div",{style:{display:"flex",flexDirection:"column",gap:"20px"}},
      h("div",{style:{background:"white",border:`1px solid ${COLORS.line}`,borderRadius:"16px",padding:"24px",display:"flex",justifyContent:"space-between",alignItems:"center"}},
        h("div",null,
          h("h2",{className:"font-display",style:{fontSize:"22px",fontWeight:"700",color:COLORS.forest}},"Good morning"),
          h("p",{style:{fontSize:"13px",color:COLORS.soft,marginTop:"4px"}},`${Math.round(pct*100)}% done today • ${streak}d longest streak`)
        ),
        h("div",{style:{width:"56px",height:"56px",position:"relative"}},
          h("svg",{width:56,height:56,viewBox:"0 0 56 56"},
            h("circle",{cx:28,cy:28,r:22,stroke:COLORS.line,strokeWidth:6,fill:"none"}),
            h("circle",{cx:28,cy:28,r:22,stroke:COLORS.meadow,strokeWidth:6,fill:"none",strokeLinecap:"round",strokeDasharray:138,strokeDashoffset:138-(pct*138),transform:"rotate(-90 28 28)",style:{transition:"all 0.4s"}})
          ),
          h("div",{style:{position:"absolute",inset:0,display:"flex",alignItems:"center",justifyContent:"center",fontSize:"14px",fontWeight:"700"}},`${Math.round(pct*100)}%`)
        )
      ),
      h("div",{style:{display:"flex",flexDirection:"column",gap:"10px"}},
        habits.map(habit=>h("div",{key:habit.id,style:{background:"white",border:`1px solid ${COLORS.line}`,borderRadius:"14px",padding:"14px 16px",display:"flex",justifyContent:"space-between",alignItems:"center"}},
          h("div",{style:{display:"flex",gap:"12px",alignItems:"center"}},
            h("div",{style:{width:"36px",height:"36px",borderRadius:"10px",background:habit.color+"22",display:"flex",alignItems:"center",justifyContent:"center",fontSize:"18px"}},habit.icon),
            h("div",null,
              h("div",{style:{fontSize:"14px",fontWeight:"500"}},habit.name),
              h("div",{style:{fontSize:"11px",color:COLORS.soft}},`${Object.keys(habit.completions).length} completions`)
            )
          ),
          h("button",{onClick:()=>toggle(habit.id),style:{width:"32px",height:"32px",borderRadius:"999px",border:`1px solid ${habit.completions[todayStr()]?COLORS.meadow:COLORS.line}`,background:habit.completions[todayStr()]?COLORS.meadow:"white",color:habit.completions[todayStr()]?"white":COLORS.soft,cursor:"pointer"}},habit.completions[todayStr()]?"✓":"")
        ))
      )
    ),
    tab==="habits" && h("div",null,
      h("h2",{className:"font-display",style:{fontSize:"20px",fontWeight:"700"}},"Your Habits"),
      h("div",{style:{marginTop:"16px",display:"flex",flexDirection:"column",gap:"10px"}},
        habits.map(hb=>h("div",{key:hb.id,style:{background:"white",border:`1px solid ${COLORS.line}`,borderRadius:"12px",padding:"12px 16px",display:"flex",justifyContent:"space-between"}},
          h("span",null,hb.icon+" "+hb.name),
          h("button",{onClick:()=>setHabits(p=>p.filter(x=>x.id!==hb.id)),style:{color:"#B4402F",border:"none",background:"transparent",cursor:"pointer",fontSize:"12px"}},"Delete")
        ))
      ),
      h("button",{onClick:()=>{
        const name=prompt("Habit name?");
        if(!name) return;
        setHabits(p=>[...p,{id:Date.now().toString(),name,icon:"⭐",color:COLORS.meadow,completions:{}}]);
      },style:{marginTop:"16px",padding:"10px 16px",borderRadius:"10px",background:COLORS.forest,color:"white",border:"none",cursor:"pointer"}},"+ Add Habit")
    ),
    tab==="progress" && h("div",{style:{background:"white",border:`1px solid ${COLORS.line}`,borderRadius:"16px",padding:"20px"}},
      h("h2",{className:"font-display",style:{fontSize:"20px",fontWeight:"700"}},"Progress"),
      h("p",{style:{fontSize:"13px",color:COLORS.soft,marginTop:"8px"}},`Longest streak: ${streak} days • Total habits: ${habits.length}`),
      h("div",{style:{marginTop:"20px",display:"grid",gridTemplateColumns:"repeat(7,1fr)",gap:"8px"}},
        [...Array(7)].map((_,i)=>{
          const key=daysAgo(6-i);
          const count=habits.filter(h=>h.completions[key]).length;
          return h("div",{key,style:{textAlign:"center"}},
            h("div",{style:{height:`${20+count*20}px`,background:COLORS.meadow,borderRadius:"6px",marginBottom:"6px",opacity:0.6+count*0.1}}),
            h("div",{style:{fontSize:"10px",color:COLORS.soft}},new Date(key).toLocaleDateString(undefined,{weekday:"short"}).slice(0,2))
          );
        })
      )
    )
  );
}
createRoot(document.getElementById("app")).render(h(App));
</script>
